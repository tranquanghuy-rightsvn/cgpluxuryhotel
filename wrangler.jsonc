// Worker "cgpluxuryhotel": phục vụ site tĩnh html/ + API thanh toán AsiaPay PayDollar /api/* (worker/index.js).
// Khóa bí mật KHÔNG để ở đây — đặt bằng `npx wrangler secret put <TÊN>` (production) hoặc file .dev.vars (local):
//   ASIAPAY_SECURE_HASH_SECRET  (Merchant Admin > Profile > Payment Account Information)
//   ASIAPAY_API_PASSWORD        (mật khẩu của API login, email "Test Account Password Setup")
//   ADMIN_API_KEY               (chuỗi ngẫu nhiên ≥ 24 ký tự, trùng Script Property WORKER_ADMIN_KEY của GAS CMS)
// Datafeed: trong Merchant Admin > Profile > Payment Options bật Data Feed, URL = <SITE_URL>/api/asiapay/datafeed
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cgpluxuryhotel",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  "assets": {
    "directory": "./html",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Bắt buộc để /api/* luôn chạy Worker thay vì trả trang 404 tĩnh
    "run_worker_first": ["/api/*"]
  },

  // Bật khi trỏ domain về Cloudflare:
  // "routes": [{ "pattern": "cgpgrouphotel.com", "custom_domain": true }],

  // D1 tạo ngày 27/11/2026 (`npx wrangler d1 create cgpluxuryhotel`)
  "d1_databases": [
    { "binding": "DB", "database_name": "cgpluxuryhotel", "database_id": "d4b88deb-5e30-4f5e-83bb-f14118482d81", "migrations_dir": "worker/migrations" }
  ],

  // Email giao dịch qua Cloudflare Email Service — domain gửi (MAIL_FROM) phải bật Email Sending
  // (`npx wrangler email sending enable`), cần gói Workers Paid.
  "send_email": [{ "name": "EMAIL" }],

  // 10 phút/lần: hỏi Query API (orderApi.jsp) cho các đơn pending quá 15 phút
  "triggers": { "crons": ["*/10 * * * *"] },

  "vars": {
    "SITE_URL": "https://cgpgrouphotel.com",
    // Môi trường TEST (UAT) của AsiaPay. Lên thật: đổi sang URL production + Merchant ID/secret AsiaPay cấp sau khi
    // ký UAT Acceptance Form (hỏi AsiaPay URL production của tài khoản Việt Nam).
    "ASIAPAY_BASE_URL": "https://test.paydollar.com/b2cDemo",
    "ASIAPAY_MERCHANT_ID": "74002484",
    "ASIAPAY_API_LOGIN": "apicpglxr",
    "ASIAPAY_PAY_METHOD": "CC",
    "ASIAPAY_HASH_ALGO": "SHA-1",
    // Tài khoản 74002484 mở bằng VND. Giá web bằng USD -> quy đổi theo tỷ giá này.
    "ASIAPAY_CURRENCY": "VND",
    "MAIL_FROM": "booking@cgpgrouphotel.com",
    "MAIL_REPLY_TO": "cgpluxuryhotelhoian@gmail.com",
    "HOTEL_NOTIFY_EMAIL": "cgpluxuryhotelhoian@gmail.com"
  },

  "observability": { "enabled": true }
}
